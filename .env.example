# Which AI reads the letters: "gemini" (free tier) or "claude" (paid, Anthropic).
AI_PROVIDER=gemini

# Free key from https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Only needed if AI_PROVIDER=claude. Get one at https://platform.claude.com/
# ANTHROPIC_API_KEY=sk-ant-...

# Optional settings
# OPEN_LETTER_MODEL=gemini-flash-latest   (or claude-opus-5-5 for Claude)
# OPEN_LETTER_EFFORT=medium               (Claude only)
# OPEN_LETTER_RATE_LIMIT=15
